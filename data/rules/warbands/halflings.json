{
    "id": "halflings",
    "name": "Halflings",
    "faction": "The Moot",
    "race": "Halfling",

    "description": "A band of Halflings from the Moot, drawn away from village life by the promise of adventure and, more importantly, good food.",

    "startingTreasury": 500,
    "minimumWarbandSize": 3,
    "maximumWarbandSize": 20,

    "source": {
        "organisation": "The New Mordheimer",
        "document": "Grade 2a Warbands - Halflings (fan-made supplement, not part of the official core rulebook)",
        "website": "https://mordheimer.net",
        "url": "https://mordheimer.net/docs/warbands/grade-2a-warbands/halflings"
    },

    "specialRules": [
        {
            "id": "pretty-much-human",
            "name": "Pretty Much Human",
            "summary": "Halflings are pretty much human and therefore may hire any Hired Sword available to human mercenary warbands."
        },
        {
            "id": "too-big",
            "name": "Too Big",
            "summary": "Halflings may never use Long Bows, Elf Bows, Handguns, Long Rifles or Blunderbusses, even if an Advance roll would otherwise allow it - such big weapons aren't built for such tiny hands."
        },
        {
            "id": "halfling-items",
            "name": "Halfling Items",
            "summary": "Halflings do not gain any bonus from Halfling-themed items (such as the Halfling Cookbook) - they already know all the knowledge such things could teach them."
        }
    ],

